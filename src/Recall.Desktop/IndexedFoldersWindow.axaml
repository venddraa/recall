<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Recall.Desktop.IndexedFoldersWindow"
        Title="Indexed Folders"
        Width="700" Height="440" MinWidth="600" MinHeight="380"
        WindowStartupLocation="CenterOwner" Background="#D4D0C8">
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" Margin="14">
        <TextBlock Text="Choose the folders Recall may index." Margin="0,0,0,10" />

        <Border Grid.Row="1" BorderBrush="#808080" BorderThickness="1" Background="White">
            <Grid>
                <ListBox x:Name="FoldersList" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         SelectionChanged="FoldersList_OnSelectionChanged"
                         AutomationProperties.Name="Selected folders" />
                <TextBlock x:Name="EmptyFoldersText" Text="No folders selected."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#606060" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
            <Button x:Name="AddFolderButton" Content="Add Folder..." Click="AddFolder_OnClick" />
            <Button x:Name="RemoveFolderButton" Content="Remove Folder" IsEnabled="False"
                    Click="RemoveFolder_OnClick" />
            <Button x:Name="ScanFolderButton" Content="Scan Folder" IsEnabled="False"
                    Click="ScanFolder_OnClick"
                    ToolTip.Tip="Update only the selected folder, reusing unchanged file contents" />
            <Button x:Name="ReindexFolderButton" Content="Reindex Folder" IsEnabled="False"
                    Click="ReindexFolder_OnClick"
                    ToolTip.Tip="Reread all supported file contents in the selected folder" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="6" Margin="0,10,0,10">
            <TextBlock x:Name="MessageText" IsVisible="False" TextWrapping="Wrap" />
            <TextBlock Text="Changes are saved immediately. Removing a folder does not delete its files."
                       Foreground="#606060" TextWrapping="Wrap" />
            <TextBlock Text="Scan Folder checks changes and reuses unchanged contents. Reindex Folder rereads all supported contents. Both close this dialog and process only the selected folder."
                       Foreground="#606060" TextWrapping="Wrap" />
        </StackPanel>

        <Button x:Name="CloseButton" Grid.Row="4" Content="Close" MinWidth="76"
                HorizontalAlignment="Right" IsCancel="True" Click="Close_OnClick" />
    </Grid>
</Window>
