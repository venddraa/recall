<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Recall.Desktop.SettingsWindow"
        Title="Recall Settings" Width="600" Height="460"
        MinWidth="480" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="#ECEFF1" Foreground="#27333E">
    <Window.Styles>
        <StyleInclude Source="/Styles/UtilityButtons.axaml" />
    </Window.Styles>
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeAccentBrush">#55758F</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeAccentBrush2">#BDD1E0</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeAccentBrush3">#D1E0EA</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeAccentBrush4">#DCE7EF</SolidColorBrush>
    </Window.Resources>
    <Grid RowDefinitions="Auto,*,Auto,Auto">
        <Border Background="#F5F7F8" BorderBrush="#D6DDE3" BorderThickness="0,0,0,1" Padding="18,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Settings" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Choose when Recall updates the index for your selected folders."
                           Foreground="#5D6A75" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="18,14,18,0"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      AutomationProperties.Name="Index update settings">
            <StackPanel Spacing="10">
                <Border Background="White" BorderBrush="#CAD3DA" BorderThickness="1" CornerRadius="4" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="While Recall is open" FontWeight="SemiBold" />
                        <CheckBox x:Name="AutomaticUpdatesCheckBox"
                                  IsChecked="True" IsThreeState="False"
                                  AutomationProperties.Name="Automatic index updates">
                            <TextBlock Text="Automatically update the index while Recall is open" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="Changes are watched only in your selected folders. When disabled, use Index → Scan Folders to update the index."
                                   TextWrapping="Wrap" Foreground="#5D6A75" FontSize="12" />
                        <TextBlock Text="Use Scan Folders, or enable startup scanning below, to catch changes made while Recall was closed or automatic updates were off."
                                   TextWrapping="Wrap" Foreground="#5D6A75" FontSize="12" />
                    </StackPanel>
                </Border>

                <Border Background="White" BorderBrush="#CAD3DA" BorderThickness="1" CornerRadius="4" Padding="14">
                    <StackPanel Spacing="8">
                        <TextBlock Text="When Recall opens" FontWeight="SemiBold" />
                        <CheckBox x:Name="ScanOnStartupCheckBox"
                                  IsChecked="False" IsThreeState="False"
                                  AutomationProperties.Name="Scan selected folders when Recall opens">
                            <TextBlock Text="Scan selected folders when Recall opens" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock Text="Starts on the next launch, even if automatic updates are off. Large folders may take time. Use Index → Cancel Scan to stop."
                                   TextWrapping="Wrap" Foreground="#5D6A75" FontSize="12" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="18,10,18,0" Background="#FFF3F1"
                BorderBrush="#D7A9A1" BorderThickness="1" CornerRadius="4" Padding="10,8"
                IsVisible="{Binding #MessageText.IsVisible}">
            <TextBlock x:Name="MessageText" IsVisible="False" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="3" Background="#F5F7F8" BorderBrush="#D6DDE3" BorderThickness="0,1,0,0"
                Padding="18,12" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" MinWidth="84"
                        IsCancel="True" Click="Cancel_OnClick" />
                <Button x:Name="SaveButton" Classes="primary" Content="Save" MinWidth="84"
                        IsDefault="True" Click="Save_OnClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
