<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Recall.Desktop.SettingsWindow"
        Title="Recall Settings" Width="530" SizeToContent="Height"
        MinWidth="430" MinHeight="285"
        WindowStartupLocation="CenterOwner" Background="#D4D0C8">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="14">
        <TextBlock Text="Index updates" Margin="0,0,0,12" />
        <StackPanel Grid.Row="1" Spacing="10">
            <CheckBox x:Name="AutomaticUpdatesCheckBox"
                      IsChecked="True" IsThreeState="False"
                      AutomationProperties.Name="Automatic index updates">
                <TextBlock Text="Automatically update the index while Recall is open" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="Changes are watched only in your selected folders.&#10;When disabled, use Index → Scan Folders to update the index."
                       TextWrapping="Wrap" Foreground="#606060" />
            <TextBlock Text="Use Scan Folders, or enable startup scanning below, to catch changes made while Recall was closed or automatic updates were off."
                       TextWrapping="Wrap" Foreground="#606060" />
            <CheckBox x:Name="ScanOnStartupCheckBox"
                      IsChecked="False" IsThreeState="False"
                      AutomationProperties.Name="Scan selected folders when Recall opens">
                <TextBlock Text="Scan selected folders when Recall opens" TextWrapping="Wrap" />
            </CheckBox>
            <TextBlock Text="Starts on the next launch, even if automatic updates are off. Large folders may take time. Use Index → Cancel Scan to stop."
                       TextWrapping="Wrap" Foreground="#606060" />
        </StackPanel>
        <TextBlock x:Name="MessageText" Grid.Row="2" IsVisible="False"
                   TextWrapping="Wrap" Margin="0,10" VerticalAlignment="Center" />
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button x:Name="SaveButton" Content="Save" MinWidth="76"
                    IsDefault="True" Click="Save_OnClick" />
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="76"
                    IsCancel="True" Click="Cancel_OnClick" />
        </StackPanel>
    </Grid>
</Window>
