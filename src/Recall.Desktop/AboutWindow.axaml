<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Recall.Desktop.AboutWindow"
        Title="About Recall"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#D4D0C8">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="20">
        <TextBlock Text="Recall" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Margin="0,12,0,16" TextWrapping="Wrap"
                   Text="Find local files by the words you remember.&#10;&#10;Your files stay on your computer." />
        <TextBlock Grid.Row="2" Text="Version / build" Margin="0,0,0,6" />
        <TextBox x:Name="BuildVersionText" Grid.Row="3" IsReadOnly="True"
                 TextWrapping="Wrap" MaxHeight="100"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ToolTip.Tip="Select and copy this version when reporting a problem. Build metadata includes the base source commit when available."
                 AutomationProperties.Name="Recall version and build metadata" />
        <Button Grid.Row="4" Content="OK" MinWidth="76" Margin="0,16,0,0"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                Click="Close_OnClick" />
    </Grid>
</Window>
