<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Recall.Desktop"
        x:Class="Recall.Desktop.ScanReportWindow"
        Title="Last Completed Scan" Width="820" Height="620" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#ECEFF1" Foreground="#27333E">
    <Window.Styles>
        <StyleInclude Source="/Styles/UtilityButtons.axaml" />
        <Style Selector="ListBox#IssuesList ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E8EDF1" />
        </Style>
        <Style Selector="ListBox#IssuesList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0F4F7" />
        </Style>
        <Style Selector="ListBox#IssuesList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCE7EF" />
            <Setter Property="BorderBrush" Value="#CBD8E2" />
        </Style>
        <Style Selector="ListBox#IssuesList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D1E0EA" />
        </Style>
        <Style Selector="ListBox#IssuesList ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D1E0EA" />
        </Style>
    </Window.Styles>
    <Window.Resources>
        <SolidColorBrush x:Key="ThemeAccentBrush">#55758F</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeAccentBrush2">#BDD1E0</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeAccentBrush3">#D1E0EA</SolidColorBrush>
        <SolidColorBrush x:Key="ThemeAccentBrush4">#DCE7EF</SolidColorBrush>
    </Window.Resources>
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
        <Border Background="#F5F7F8" BorderBrush="#D6DDE3" BorderThickness="0,0,0,1" Padding="18,16">
            <StackPanel Spacing="4">
                <TextBlock x:Name="ReportHeadingText" Text="Last completed scan" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Text="Review scan totals and a sample of files that need attention."
                           Foreground="#5D6A75" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto" Margin="18,14,18,10">
            <TextBlock Text="Scan summary" FontSize="12" FontWeight="SemiBold" Foreground="#4C5965"
                       Margin="0,0,0,6" />
            <TextBox x:Name="SummaryText" Grid.Row="1" Height="94" IsReadOnly="True"
                     Background="White" BorderBrush="#CAD3DA" CornerRadius="4" TextWrapping="Wrap"
                     AutomationProperties.Name="Completed scan summary" />
            <TextBlock x:Name="ReportNoteText" Grid.Row="2" Margin="0,8,0,0" FontSize="12"
                       Foreground="#5D6A75" TextWrapping="Wrap" />
        </Grid>

        <Border Grid.Row="2" Margin="18,0,18,10" BorderBrush="#CAD3DA" BorderThickness="1"
                CornerRadius="4" Background="White" ClipToBounds="True" MinHeight="80">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#F6F8FA" BorderBrush="#DFE5EA" BorderThickness="0,0,0,1" Padding="12,8">
                    <Grid ColumnDefinitions="2*,3*,3*">
                        <TextBlock Text="Name" FontSize="12" FontWeight="SemiBold" Foreground="#4C5965" />
                        <TextBlock Grid.Column="1" Text="Folder" Margin="8,0,0,0"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#4C5965" />
                        <TextBlock Grid.Column="2" Text="Reason" Margin="8,0,0,0"
                                   FontSize="12" FontWeight="SemiBold" Foreground="#4C5965" />
                    </Grid>
                </Border>
                <ListBox x:Name="IssuesList" Grid.Row="1" BorderThickness="0"
                         SelectionChanged="IssuesList_OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Sample indexing issues">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ScanIssueRow">
                            <Grid ColumnDefinitions="2*,3*,3*">
                                <TextBlock Text="{Binding Filename}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                <TextBlock Grid.Column="1" Text="{Binding Folder}" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                                <TextBlock Grid.Column="2" Text="{Binding Reason}" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Reason}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyIssuesText" Grid.Row="1" Text="No detailed issues were recorded."
                           Margin="20" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#61707D" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" RowDefinitions="Auto,Auto" Margin="18,0,18,12">
            <TextBlock Text="Selected issue" FontSize="12" FontWeight="SemiBold" Foreground="#4C5965"
                       Margin="0,0,0,6" />
            <TextBox x:Name="IssueDetailsText" Grid.Row="1" Height="66" IsReadOnly="True"
                     Background="White" BorderBrush="#CAD3DA" CornerRadius="4" TextWrapping="Wrap"
                     Text="Select an issue to see its full path and reason."
                     AutomationProperties.Name="Selected issue path and reason" />
        </Grid>

        <Border Grid.Row="4" Background="#F5F7F8" BorderBrush="#D6DDE3"
                BorderThickness="0,1,0,0" Padding="18,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button x:Name="CopyReportButton" Classes="primary" Content="Copy Report" MinWidth="120"
                        IsEnabled="False" Click="CopyReport_OnClick"
                        ToolTip.Tip="Copy the scan summary and sample issues to the clipboard"
                        AutomationProperties.Name="Copy completed scan report" />
                <TextBlock x:Name="CopyStatusText" Grid.Column="1" Margin="10,0"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.Name="Report copy status" />
                <Button Grid.Column="2" Content="Close" MinWidth="84"
                        IsDefault="True" IsCancel="True" Click="Close_OnClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
