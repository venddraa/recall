<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Recall.Desktop"
        x:Class="Recall.Desktop.ScanReportWindow"
        Title="Last Completed Scan" Width="820" Height="620" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="#D4D0C8">
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="14">
        <TextBlock x:Name="ReportHeadingText" Text="Last completed scan" FontWeight="Bold" Margin="0,0,0,8" />
        <TextBox x:Name="SummaryText" Grid.Row="1" Height="140" IsReadOnly="True"
                 TextWrapping="Wrap" Margin="0,0,0,10"
                 AutomationProperties.Name="Completed scan summary" />
        <Border Grid.Row="2" BorderBrush="#808080" BorderThickness="1" Background="White">
            <Grid RowDefinitions="Auto,*">
                <Border Background="#D4D0C8" BorderBrush="#808080" BorderThickness="0,0,0,1" Padding="8,6">
                    <Grid ColumnDefinitions="2*,3*,3*">
                        <TextBlock Text="Name" />
                        <TextBlock Grid.Column="1" Text="Folder" Margin="8,0,0,0" />
                        <TextBlock Grid.Column="2" Text="Reason" Margin="8,0,0,0" />
                    </Grid>
                </Border>
                <ListBox x:Name="IssuesList" Grid.Row="1" BorderThickness="0"
                         SelectionChanged="IssuesList_OnSelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Sample indexing issues">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8,6" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ScanIssueRow">
                            <Grid ColumnDefinitions="2*,3*,3*">
                                <TextBlock Text="{Binding Filename}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FullPath}" />
                                <TextBlock Grid.Column="1" Text="{Binding Folder}" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Folder}" />
                                <TextBlock Grid.Column="2" Text="{Binding Reason}" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Reason}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyIssuesText" Grid.Row="1" Text="No detailed issues were recorded."
                           Margin="20" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#606060" IsHitTestVisible="False" />
            </Grid>
        </Border>
        <TextBlock x:Name="ReportNoteText" Grid.Row="3" Margin="0,8" Foreground="#606060" TextWrapping="Wrap" />
        <TextBox x:Name="IssueDetailsText" Grid.Row="4" Height="64" IsReadOnly="True" TextWrapping="Wrap"
                 Text="Select an issue to see its full path and reason."
                 AutomationProperties.Name="Selected issue path and reason" />
        <Button Grid.Row="5" Content="Close" MinWidth="76" Margin="0,10,0,0"
                HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Close_OnClick" />
    </Grid>
</Window>
